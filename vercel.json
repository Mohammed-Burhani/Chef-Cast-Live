{
  "buildCommand": "expo export -p web",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/auto-live",
      "schedule": "* * * * *"
    }
  ],
  "devCommand": "expo",
  "cleanUrls": true,
  "framework": null,
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/"
    }
  ]
}
