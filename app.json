{
  "expo": {
    "name": "ChefCast: Live",
    "slug": "foodilicious-live",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chefcast-live",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chefcast.live"
    },
    "android": {
      "package": "com.chefcast.live",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static",
      "bundler": "metro"
    },
    "notification": {
      "vapidPublicKey": "REPLACE_WITH_YOUR_VAPID_PUBLIC_KEY",
      "serviceWorkerPath": "/expo-service-worker.js"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image-picker",
      "expo-camera",
      "expo-notifications",
      "expo-apple-authentication",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-barcode-scanner"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://replit.com/"
      },
      "eas": {
        "projectId": "8d89f8a4-3aba-40db-b6d5-f81caa4e3e28"
      }
    },
    "owner": "burhani-technologies"
  }
}
